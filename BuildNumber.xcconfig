// CURRENT_PROJECT_VERSION（即 App 的 CFBundleVersion）注入配置。
//
// 原理：工程所有 target 的 build number 统一由 CURRENT_PROJECT_VERSION 生成到 Info.plist。
// Xcode 归档前，scheme 的 Archive Pre-action 会运行 tools/set_build_number.sh，
// 生成 build/generated/BuildNumber.generated.xcconfig（内容为 git 提交次数）；
// 本文件通过可选 include 把生成值注入为 CURRENT_PROJECT_VERSION。
//
// - include 的文件不存在时（未跑过 pre-action / 命令行打包），回退为 1；
// - 命令行 xcodebuild 传入的 CURRENT_PROJECT_VERSION 优先级高于本文件。
CURRENT_PROJECT_VERSION = 1
#include? "build/generated/BuildNumber.generated.xcconfig"
